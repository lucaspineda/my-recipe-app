# Keeps local `docker build` contexts the same as what `gcloud run deploy --source .`
# uploads (.gcloudignore + .gitignore). .env must NOT be listed: next build reads it.
.git
.gitignore
.gcloudignore
.dockerignore
.claude
node_modules
.pnp
.pnp.js
.yarn/install-state.gz
coverage
.next
.next-dev
out
build
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firestore-debug.log
.env*.local
.vercel
*.tsbuildinfo
next-env.d.ts
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
scripts/serviceAccountKey.json
certificates
